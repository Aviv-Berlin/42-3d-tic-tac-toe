{
	"compilerOptions": {
	  "target": "esnext",
	  "noUnusedLocals": true,
	  "noUnusedParameters": true,
	  "noImplicitReturns": true,
	  "noFallthroughCasesInSwitch": true,
	  "module": "nodenext",
	  "esModuleInterop": true,
		"strict": true,
		"rootDir": "..",
		"outDir": "dist"
	},
	"include": ["src/**/*", "types/**/*.d.ts"]
}
